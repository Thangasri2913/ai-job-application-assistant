{
  "name": "@job-assist/mobile",
  "version": "0.1.0",
  "private": true,
  "description": "JobAssist Android app (Expo + React Native). Standalone package: not an npm workspace, so React Native never affects the web app's dependencies.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "bundle:android": "expo export --platform android --output-dir dist-android",
    "usb": "bash scripts/usb.sh",
    "start:usb": "bash scripts/usb.sh && expo start --localhost",
    "eas-build-post-install": "cd ../.. && npm run build:shared"
  },
  "dependencies": {
    "@job-assist/shared": "file:../../packages/shared",
    "expo": "~57.0.28",
    "expo-auth-session": "~57.0.15",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.4",
    "expo-linking": "~57.0.12",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "lucide-react-native": "^1.57.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "~29.5.14",
    "@types/node": "~22.18.0",
    "@types/react": "~19.2.0",
    "jest": "^29.7.0",
    "jest-expo": "^57.0.6",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/__tests__/**/*.test.ts?(x)"
    ],
    "clearMocks": true,
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "testTimeout": 30000,
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|react-native-svg|react-native-safe-area-context|lucide-react-native)"
    ],
    "moduleNameMapper": {
      "^lucide-react-native/icons/(.*)$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/icons/$1.js",
      "^lucide-react-native$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/lucide-react-native.js"
    }
  }
}
