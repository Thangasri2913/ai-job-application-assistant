*.pem
*.key
*.p12
*.pfx

# Logs & OS
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Local dev script logs (scripts/dev.sh)
.dev/

# Playwright
test-results/
playwright-report/
