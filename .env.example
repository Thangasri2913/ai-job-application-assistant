# Copy to .env and adjust. Never commit .env.
# This single file is read by docker compose, the API and Prisma.

# ---- Runtime ----
NODE_ENV=development
LOG_LEVEL=debug

# ---- API ----
# Hosts that set PORT (e.g. Render) can omit API_PORT; API_PORT wins when both are set.
API_PORT=3000
# Comma-separated list of browser origins allowed to call the API ("*" is rejected in production).
CORS_ORIGINS=http://localhost:4200
# Reverse-proxy hops to trust for client IPs (rate limiting). Use 1 on Render.
# TRUST_PROXY_HOPS=0
# Serve Swagger UI at /api/docs (keep false in production unless protected).
SWAGGER_ENABLED=true

# ---- PostgreSQL (docker compose) ----
# Host port 5434 avoids clashing with other local Postgres instances on 5432.
POSTGRES_HOST_PORT=5434
POSTGRES_USER=job_assist
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=job_assist
DATABASE_URL=postgresql://job_assist:change-me-local-only@localhost:5434/job_assist?schema=public
# Optional: direct (non-pooled) connection used only by `prisma migrate deploy`, e.g. Neon's
# direct URL when DATABASE_URL is the pooled one. Defaults to DATABASE_URL.
# DIRECT_DATABASE_URL=
# Separate database used by the API integration (e2e) tests. Created by infrastructure/docker/postgres/init.
TEST_DATABASE_URL=postgresql://job_assist:change-me-local-only@localhost:5434/job_assist_test?schema=public

# ---- Object storage (S3-compatible; SeaweedFS locally via docker compose) ----
S3_HOST_PORT=8333
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=job-assist-files
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=local-dev-access-key
S3_SECRET_ACCESS_KEY=change-me-local-only-secret
# Create the bucket on API start if missing (development convenience; keep false in production).
S3_AUTO_CREATE_BUCKET=true

# ---- Resume uploads ----
RESUME_MAX_UPLOAD_BYTES=5242880


# ---- Identity: Keycloak (docker compose) ----
# Keycloak owns users, passwords, sessions and tokens. The app stores no passwords.
KEYCLOAK_HOST_PORT=8180
# Phone sign-in over Wi-Fi (docs/MOBILE.md): Keycloak must be reachable at, and issue tokens
# for, your computer's LAN address. Development only — this also exposes the admin console
# on your network. Set KEYCLOAK_ISSUER_URL and VITE_KEYCLOAK_URL to the same address.
# KEYCLOAK_PUBLIC_URL=http://192.168.1.20:8180
# KEYCLOAK_BIND_ADDRESS=0.0.0.0
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-local-admin-password
KEYCLOAK_DB_PASSWORD=change-me-local-keycloak-db-password

# API token validation (issuer must match exactly what Keycloak puts in tokens).
KEYCLOAK_ISSUER_URL=http://localhost:8180/realms/ai-job-assistant
# The web app's client id; tokens must have been issued to it (azp claim).
KEYCLOAK_CLIENT_ID=ai-job-assistant-web
# Audience the API requires in access tokens (added by the realm's audience mapper).
KEYCLOAK_AUDIENCE=ai-job-assistant-api
# Optional: the Android app's public client (PKCE, no secret). When set, its tokens are accepted
# too. See docs/MOBILE.md.
# KEYCLOAK_MOBILE_CLIENT_ID=ai-job-assistant-mobile

# ---- Web app (public values only — everything VITE_* is shipped to the browser) ----
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=ai-job-assistant
VITE_KEYCLOAK_CLIENT_ID=ai-job-assistant-web
# Relative by default: the Vite dev server proxies /api to the API (same origin).
VITE_API_URL=/api/v1

# ---- Rate limiting (per client IP) ----
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX=100
# Resume uploads per window per client
UPLOAD_RATE_LIMIT_MAX=10
# Job analyses started per client per window (analysis may call the AI provider).
JOB_ANALYSIS_RATE_LIMIT_MAX=20

# ---- Job discovery (ADR-0018, docs/JOB-DISCOVERY.md) ----
# Comma-separated job sources, e.g. JOB_SOURCES=adzuna,remotive,greenhouse,lever
#   adzuna     real jobs, official Adzuna API (needs ADZUNA_APP_ID / ADZUNA_APP_KEY)
#   remotive   real remote jobs, Remotive public API (no key; read its terms first)
#   greenhouse real jobs from employer boards on Greenhouse (needs GREENHOUSE_BOARDS)
#   lever      real jobs from employer sites on Lever (needs LEVER_SITES)
#   dev        built-in development sample postings — NOT real jobs; refused in production
# Empty = no sources: alert runs fail with a clear message. LinkedIn, Naukri and Indeed are
# not integrated (no permitted API; the app never logs in as you or scrapes them).
# Credentials go in env vars only, never in the DB or source control.
JOB_SOURCES=dev
# Runs due job alerts in-process every N seconds.
JOB_ALERT_SCHEDULER_ENABLED=true
JOB_ALERT_SCHEDULER_INTERVAL_SECONDS=60
# Real jobs from the official Adzuna API (enable with JOB_SOURCES=adzuna; production uses this).
# Register an application at https://developer.adzuna.com to get the ID and key (secrets:
# never commit them; in production set them only in Render).
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=
# ADZUNA_COUNTRY=in              # Adzuna country code: in, gb, us, au, ca, de, …
# ADZUNA_MAX_DAYS_OLD=30
# ADZUNA_DAILY_REQUEST_LIMIT=200 # stay under Adzuna's 250 requests/day default
# Remotive: one cached feed request serves every alert; Remotive asks for at most 4/day.
# REMOTIVE_DAILY_REQUEST_LIMIT=4
# Employer job boards (public data, no credentials): board tokens / site names, each
# optionally "id=Employer name". Only these boards are read — the app never crawls for boards.
# GREENHOUSE_BOARDS=
# LEVER_SITES=
# LEVER_REGION=global             # or eu for sites on Lever's EU data centre

# ---- Smart Apply (ADR-0020, docs/SMART-APPLY.md) ----
# Automatic submission stays off unless enabled AND an authorised submission integration
# exists (none ships today). Preparation and handoff to the official site always work.
# SMART_APPLY_AUTO_SUBMIT_ENABLED=false
# SMART_APPLY_MAX_CONCURRENT=2            # background tasks at once, all users
# SMART_APPLY_MAX_SUBMISSION_ATTEMPTS=3   # retries only for failures the provider says weren't accepted
# SMART_APPLY_RETRY_BASE_SECONDS=60       # first retry delay, doubled per attempt
# SMART_APPLY_WORKER_INTERVAL_SECONDS=30  # how often due retries/reconciliations are checked
# SMART_APPLY_FETCH_EMPLOYER_QUESTIONS=true  # read Greenhouse's public application questions

# ---- AI (optional resume structuring) ----
# none (default: rule-based parsing only) | mock (tests) | anthropic
AI_PROVIDER=none
AI_MODEL=claude-opus-5
# Required only for AI_PROVIDER=anthropic (the SDK can also use `ant auth login` credentials).
# ANTHROPIC_API_KEY=
